# Copy to .env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./data/app.db
DB_BUSY_TIMEOUT_MS=5000

# Simulation limits
SIMULATION_DEFAULT_SEED=12345
SIMULATION_MAX_RUNS=100000
SIMULATION_MAX_WORKERS=4

# AI provider (optional; AI can be disabled)
OPENAI_API_KEY=
OPENAI_MODEL=

# Fabricate (runtime adapter, separate from Cursor MCP)
FABRICATE_API_URL=
FABRICATE_API_KEY=

# Petri-Pilot (local container by default)
PETRI_PILOT_MCP_URL=http://petri-pilot:8080/mcp
PETRI_PILOT_API_KEY=

# Optional queue (compose profile "queue")
REDIS_URL=

# CORS origins for local frontend dev (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:18080

# Host port of the nginx entry point in docker compose
APP_PORT=18080
