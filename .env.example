# Copy to .env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./data/app.db
DB_BUSY_TIMEOUT_MS=5000

# Simulation limits
SIMULATION_DEFAULT_SEED=12345
SIMULATION_MAX_RUNS=100000
SIMULATION_MAX_WORKERS=4
SIMULATION_MAX_HORIZON_YEARS=50
SIMULATION_RESULT_BATCH_SIZE=500
SIMULATION_HEARTBEAT_TIMEOUT_SECONDS=120
SIMULATION_WORKER_POLL_SECONDS=1
SIMULATION_SSE_POLL_SECONDS=0.5
SIMULATION_EVENT_LOG_RUNS=5

# AI provider (optional; mock used when OPENAI_USE_MOCK=true)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_USE_MOCK=true

# Fabricate (runtime adapter, separate from Cursor MCP)
FABRICATE_API_URL=
FABRICATE_API_KEY=
FABRICATE_TIMEOUT_SECONDS=60
FABRICATE_MAX_ATTEMPTS=3
FABRICATE_MAX_ARTIFACT_BYTES=50000000
FABRICATE_MAX_EQUIPMENT_ROWS=500
FABRICATE_USE_MOCK=true
FABRICATE_STAGING_SCHEMA_VERSION=1
GENERATION_HEARTBEAT_TIMEOUT_SECONDS=300
GENERATION_SSE_POLL_SECONDS=0.5

# Petri-Pilot (local container by default; mock used when USE_MOCK=true)
PETRI_PILOT_MCP_URL=http://petri-pilot:8080/mcp
PETRI_PILOT_API_KEY=
PETRI_PILOT_TIMEOUT_SECONDS=30
PETRI_PILOT_MAX_STATES=10000
PETRI_PILOT_USE_MOCK=true

# Optional queue (compose profile "queue")
REDIS_URL=

# CORS origins for local frontend dev (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:18080

# Host port of the nginx entry point in docker compose
APP_PORT=18080
