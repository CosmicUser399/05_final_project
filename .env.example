# Copy to .env and fill in. Never commit .env.
# Defaults match local MVP (SQLite + mocks). Secrets stay empty.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:5173,http://localhost:18080

# --- Database (app Settings) ---
# Local / default compose: SQLite file under data/.
DATABASE_URL=sqlite:///./data/app.db
DB_BUSY_TIMEOUT_MS=5000

# Compose-only override for backend/worker containers
# (default in docker-compose: sqlite:////srv/data/app.db).
# For profile "postgres":
# COMPOSE_DATABASE_URL=postgresql+psycopg://app:changeme@postgres:5432/app
COMPOSE_DATABASE_URL=

# --- Docker Compose entry / optional profiles ---
# Host port for nginx (http://localhost:${APP_PORT}).
APP_PORT=18080

# Profile "postgres" (docker compose --profile postgres up).
# Required when that profile is used; set a strong password for real deploys.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme

# Profile "petri" image tag/override.
PETRI_PILOT_IMAGE=ghcr.io/pflow-xyz/petri-pilot:latest

# Profile "queue" (optional Redis; not required for MVP job table).
REDIS_URL=

# --- Simulation limits ---
SIMULATION_DEFAULT_SEED=12345
SIMULATION_MAX_RUNS=100000
SIMULATION_MAX_WORKERS=4
SIMULATION_MAX_HORIZON_YEARS=50
SIMULATION_RESULT_BATCH_SIZE=500
SIMULATION_HEARTBEAT_TIMEOUT_SECONDS=120
SIMULATION_WORKER_POLL_SECONDS=1
SIMULATION_SSE_POLL_SECONDS=0.5
SIMULATION_EVENT_LOG_RUNS=5

# --- OpenAI (mock when OPENAI_USE_MOCK=true) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_USE_MOCK=true

# --- Fabricate runtime adapter (mock when FABRICATE_USE_MOCK=true) ---
FABRICATE_API_URL=
FABRICATE_API_KEY=
FABRICATE_TIMEOUT_SECONDS=60
FABRICATE_MAX_ATTEMPTS=3
FABRICATE_MAX_ARTIFACT_BYTES=50000000
FABRICATE_MAX_EQUIPMENT_ROWS=500
FABRICATE_USE_MOCK=true
FABRICATE_STAGING_SCHEMA_VERSION=1
GENERATION_HEARTBEAT_TIMEOUT_SECONDS=300
GENERATION_SSE_POLL_SECONDS=0.5

# --- Petri-Pilot runtime adapter (mock when PETRI_PILOT_USE_MOCK=true) ---
PETRI_PILOT_MCP_URL=http://petri-pilot:8080/mcp
PETRI_PILOT_API_KEY=
PETRI_PILOT_TIMEOUT_SECONDS=30
PETRI_PILOT_MAX_STATES=10000
PETRI_PILOT_USE_MOCK=true
